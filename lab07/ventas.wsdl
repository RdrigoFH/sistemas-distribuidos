<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:tns="http://sistemasdistribuidos.org/ventas"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  targetNamespace="http://sistemasdistribuidos.org/ventas"
                  name="VentaProductosService">

  <wsdl:types>
    <xs:schema targetNamespace="http://sistemasdistribuidos.org/ventas" elementFormDefault="qualified">
      
      <xs:complexType name="Producto">
        <xs:sequence>
          <xs:element name="id" type="xs:int"/>
          <xs:element name="nombre" type="xs:string"/>
          <xs:element name="descripcion" type="xs:string"/>
          <xs:element name="precio" type="xs:double"/>
          <xs:element name="stock" type="xs:int"/>
        </xs:sequence>
      </xs:complexType>

      <xs:element name="listarProductosRequest">
        <xs:complexType/>
      </xs:element>

      <xs:element name="listarProductosResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="productos" type="tns:Producto" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <xs:element name="obtenerProductoRequest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="id" type="xs:int"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <xs:element name="obtenerProductoResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="producto" type="tns:Producto"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <xs:element name="realizarVentaRequest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="producto_id" type="xs:int"/>
            <xs:element name="cantidad" type="xs:int"/>
            <xs:element name="cliente" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <xs:element name="realizarVentaResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="venta_id" type="xs:string"/>
            <xs:element name="cliente" type="xs:string"/>
            <xs:element name="producto_nombre" type="xs:string"/>
            <xs:element name="cantidad" type="xs:int"/>
            <xs:element name="total" type="xs:double"/>
            <xs:element name="fecha" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

    </xs:schema>
  </wsdl:types>

  <!-- Messages -->
  <wsdl:message name="listarProductosInput">
    <wsdl:part name="body" element="tns:listarProductosRequest"/>
  </wsdl:message>
  <wsdl:message name="listarProductosOutput">
    <wsdl:part name="body" element="tns:listarProductosResponse"/>
  </wsdl:message>

  <wsdl:message name="obtenerProductoInput">
    <wsdl:part name="body" element="tns:obtenerProductoRequest"/>
  </wsdl:message>
  <wsdl:message name="obtenerProductoOutput">
    <wsdl:part name="body" element="tns:obtenerProductoResponse"/>
  </wsdl:message>

  <wsdl:message name="realizarVentaInput">
    <wsdl:part name="body" element="tns:realizarVentaRequest"/>
  </wsdl:message>
  <wsdl:message name="realizarVentaOutput">
    <wsdl:part name="body" element="tns:realizarVentaResponse"/>
  </wsdl:message>

  <!-- Port Type -->
  <wsdl:portType name="VentaProductosPortType">
    <wsdl:operation name="listarProductos">
      <wsdl:input message="tns:listarProductosInput"/>
      <wsdl:output message="tns:listarProductosOutput"/>
    </wsdl:operation>
    <wsdl:operation name="obtenerProducto">
      <wsdl:input message="tns:obtenerProductoInput"/>
      <wsdl:output message="tns:obtenerProductoOutput"/>
    </wsdl:operation>
    <wsdl:operation name="realizarVenta">
      <wsdl:input message="tns:realizarVentaInput"/>
      <wsdl:output message="tns:realizarVentaOutput"/>
    </wsdl:operation>
  </wsdl:portType>

  <!-- Binding -->
  <wsdl:binding name="VentaProductosBinding" type="tns:VentaProductosPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="listarProductos">
      <soap:operation soapAction="http://sistemasdistribuidos.org/ventas/listarProductos"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="obtenerProducto">
      <soap:operation soapAction="http://sistemasdistribuidos.org/ventas/obtenerProducto"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="realizarVenta">
      <soap:operation soapAction="http://sistemasdistribuidos.org/ventas/realizarVenta"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <!-- Service -->
  <wsdl:service name="VentaProductosService">
    <wsdl:port name="VentaProductosPort" binding="tns:VentaProductosBinding">
      <soap:address location="http://localhost:5000/soap"/>
    </wsdl:port>
  </wsdl:service>

</wsdl:definitions>
